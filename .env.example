# Copy this file to `.env` and adjust. `.env` is git-ignored.

# Absolute path to your unzipped LDraw parts library: the folder that contains
# LDConfig.ldr, parts/ and p/. Download "complete.zip" from
# https://library.ldraw.org/updates?latest
# BrickLink Studio also ships one, e.g.
#   C:\Program Files\Studio 2.0\ldraw
# Use forward slashes or escaped backslashes on Windows.
LDRAW_LIBRARY_PATH=C:/LDraw/ldraw
