{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Local 3D Viewer",
  "version": "0.1.0",
  "identifier": "io.github.muhammadli3d.local3dviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Local 3D Viewer",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Offline 3D model viewer",
    "longDescription": "Offline viewer for STL, 3MF, OBJ, glTF, FBX, STEP, 3DM, LDraw, G-code and more.",
    "copyright": "Copyright (c) 2026 muhammadli3d",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
